# Required
ARCANE_BASE_URL=http://10.0.0.10:3552
ARCANE_API_KEY=arc_your_api_key_here

# Optional
# ARCANE_DEFAULT_ENV=0
# ARCANE_TIMEOUT=30
# ARCANE_STREAM_TIMEOUT=600
# ARCANE_VERIFY_SSL=true            # true | false | /path/to/ca.pem
# ARCANE_MCP_READ_ONLY=false
# ARCANE_MCP_MODULES=all            # e.g. containers,projects,images
# ARCANE_MCP_CONFIRM=auto           # auto | elicit | token
# ARCANE_MCP_TOKEN_TTL=120
# ARCANE_MCP_AUDIT_LOG=~/.arcane-mcp-audit.log

# Secrets referenced by *_env tool parameters (kept out of the chat)
# GHCR_TOKEN=...
